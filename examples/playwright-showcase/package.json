{
  "name": "bddr-playwright-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "A real-world UI and API automation project powered by bddr and Playwright",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "validate": "bddr validate --fail-on-warnings",
    "plan": "bddr plan",
    "test": "bddr run",
    "test:ui": "bddr run --tags @ui",
    "test:api": "bddr run --tags @api",
    "test:smoke": "bddr run --tags @smoke",
    "test:inline": "bddr run --pool inline",
    "verify": "npm run build && npm run validate && npm test"
  },
  "dependencies": {
    "@bddr/axios": "file:../../plugins/axios",
    "@bddr/cli": "file:../../packages/cli",
    "@bddr/core": "file:../../packages/core",
    "@bddr/playwright": "file:../../plugins/playwright",
    "@bddr/reporters": "file:../../packages/reporters",
    "@bddr/runtime": "file:../../packages/runtime",
    "axios": "^1.7.9",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  }
}
