{
  "name": "bddr-selenium-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "A real-world UI automation project powered by bddr and Selenium WebDriver, using the @bddr/selenium plugin",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "validate": "bddr validate --fail-on-warnings",
    "plan": "bddr plan",
    "test": "bddr run",
    "test:smoke": "bddr run --tags @smoke",
    "test:firefox": "bddr run -D browser=firefox",
    "test:inline": "bddr run --pool inline",
    "verify": "npm run build && npm run validate && npm test"
  },
  "dependencies": {
    "@bddr/cli": "file:../../packages/cli",
    "@bddr/core": "file:../../packages/core",
    "@bddr/reporters": "file:../../packages/reporters",
    "@bddr/runtime": "file:../../packages/runtime",
    "@bddr/selenium": "file:../../plugins/selenium",
    "selenium-webdriver": "^4.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/selenium-webdriver": "^4.1.28",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  }
}
