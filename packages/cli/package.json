{
  "name": "@bddr/cli",
  "version": "0.1.1",
  "description": "bddr command line: run, dry-run, snippets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afsarali273/bddr.git",
    "directory": "packages/cli"
  },
  "homepage": "https://afsarali273.github.io/bddr/",
  "bugs": {
    "url": "https://github.com/afsarali273/bddr/issues"
  },
  "keywords": [
    "bdd",
    "gherkin",
