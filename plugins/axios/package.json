{
  "name": "@bddr/axios",
  "version": "0.1.0",
  "description": "axios plugin for bddr: an API client fixture with base URL, auth, call log attachments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afsarali273/bddr.git",
    "directory": "plugins/axios"
  },
  "homepage": "https://afsarali273.github.io/bddr/",
  "bugs": {
    "url": "https://github.com/afsarali273/bddr/issues"
  },
  "keywords": [
    "bdd",
    "gherkin",
    "test-runner",
    "automation",
    "cucumber",
    "playwright",
    "selenium",
    "testing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@bddr/runtime": ">=0.1.0",
    "axios": ">=1.0.0"
  },
  "devDependencies": {
    "@bddr/core": "file:../../packages/core",
    "@bddr/runtime": "file:../../packages/runtime",
    "@types/node": "^22.20.5",
    "axios": "^1.7.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
