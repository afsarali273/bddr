{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@bddr/core": [
        "./packages/core/src/index.ts"
      ],
      "@bddr/runtime": [
        "./packages/runtime/src/index.ts"
      ],
      "@bddr/reporters": [
        "./packages/reporters/src/index.ts"
      ],
      "@bddr/cli": [
        "./packages/cli/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/test/**/*.ts",
    "conformance/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "examples/playwright-showcase/**",
    "examples/selenium-showcase/**"
  ]
}
